#!/usr/bin/env bash
# Offline-only: hosted OCR would upload the whole document to Firecrawl.
for arg in "$@"; do
  case "$arg" in
    --ocr|--ocr=*|--api-key|--api-key=*|--api-url|--api-url=*)
      echo "anydoc: $arg is disabled (offline-only install)" >&2; exit 2 ;;
  esac
done
unset FIRECRAWL_API_KEY
export FIRECRAWL_API_URL=http://127.0.0.1:9
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
PACKAGE_DIR="${ANYDOC_PACKAGE_DIR:-$SKILL_DIR}"
exec node "$PACKAGE_DIR/node_modules/@firecrawl/anydoc/cli.js" "$@"
